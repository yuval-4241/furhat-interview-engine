# Copy this file to .env and fill in your real values, OR export directly in your shell.
# NEVER commit the real .env or any credentials file to GitHub.

# LLM provider -- "openai" or "lab" (default)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here
LAB_LLM_TOKEN=your_lab_token_here

# Google Cloud Speech-to-Text -- plain API key (Console -> APIs & Services
# -> Credentials -> Create credentials -> API key), restricted to the
# Cloud Speech-to-Text API. Used via the REST API, not a service-account
# JSON file -- some orgs (e.g. EDU/Workspace) block service-account key
# creation via the iam.disableServiceAccountKeyCreation policy.
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# Opt-in: send emotion reactions from the synthetic-persona pipeline
# (run_demo.py / ab_test.py / demo_app.py) to a running Furhat skill.
# The live interaction demo (interaction_app.py) always attempts this,
# regardless of this flag.
ROBOT_REACTION_ENABLED=false

# The friend debrief (last turn of a Live session): the friend's Furhat face and
# voice, the same for every participant. Empty = keep the interviewer's face/voice.
FRIEND_FACE=
FRIEND_VOICE=
